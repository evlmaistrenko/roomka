# roomka control server — configuration. Copy to `.env` for local development
# (`.env` is gitignored); `npm run dev` loads it via dotenv.

# HTTP bind port. Besides /graphql the server always serves Apollo Sandbox at
# http://localhost:8080/graphql/playground and Swagger UI at
# http://localhost:8080/openapi; in production the proxy keeps them in.
ROOMKA_API_PORT=8080

# sqlite database file (parent dir auto-created). Relative to services/control,
# where `npm run dev:control` runs the server; .runtime is gitignored.
ROOMKA_DATABASE_PATH=../../.runtime/control/roomka.db

# Base URL the UI is served from. It is also the only Origin allowed to send the
# session cookie, so it has to match where the browser actually loads the app,
# and the base of the password links the server prints to its console.
ROOMKA_PUBLIC_URL=http://localhost:5173

# The stream settings — ROOMKA_ENCRYPTION_SECRET, ROOMKA_MEDIAMTX_API_ADDRESS,
# ROOMKA_MEDIAMTX_SRT_PUBLIC_ADDRESS — are gone for now along with the code that
# read them; they come back with the stream business logic.

# Optional. GraphQL introspection is on unless this is true. The SDL is public
# in the repository, so turn it off only for a deployment whose schema is not.
# It has to be done here: a proxy cannot, since queries also run over the
# subscription WebSocket, whose frames it never sees.
# ROOMKA_DISABLE_GRAPHQL_INTROSPECTION=true
