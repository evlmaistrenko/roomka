{
	email {$ROOMKA_ACME_EMAIL}
}

{$ROOMKA_HOSTNAME} {
	# The control server: GraphQL over HTTP, the subscription WebSocket on the
	# same path, and the tools over both (Apollo Sandbox at /graphql/playground,
	# Swagger UI at /openapi). /health stays unpublished: only the container's
	# own health check asks it.
	#
	# Caddy replaces X-Forwarded-For with the address it sees, and control
	# believes that header only from loopback, which is where Caddy is. The
	# Host header passes through unchanged, which the WebSocket upgrade checks
	# the Origin against.
	@control path /graphql /graphql/* /openapi /openapi/* /openapi.json
	handle @control {
		reverse_proxy 127.0.0.1:{$ROOMKA_API_PORT}
	}

	# Everything else is the UI.
	handle {
		root * /srv
		encode zstd gzip

		# Vite names every asset after its content, so an asset never changes
		# under its name. index.html does change, and names the new ones.
		@assets path /assets/*
		@notAssets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @notAssets Cache-Control "no-cache"

		# A single-page app: a path that is not a file is a route, and the
		# UI's router takes it from index.html.
		try_files {path} /index.html
		file_server
	}
}
